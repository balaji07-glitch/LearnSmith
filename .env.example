# NVIDIA_API_KEY: Create a key in the NVIDIA API Catalog.
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
# Optional: override the NVIDIA-compatible API base URL.
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"

# Supabase project URL and public anon key (VITE_ values are included in the browser).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secret. Never add the service-role key to a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Comma-separated teacher account emails allowed to view student results.
SUPABASE_TEACHER_EMAILS="teacher@school.edu"

PORT=3000
